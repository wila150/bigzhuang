# Postgres connection string (local, or Supabase "Session pooler" URI in production)
DATABASE_URL=postgres://USER@127.0.0.1:5432/bigzhaung
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=
# Public site URL, no trailing slash (used for SEO links and the sitemap)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Supabase Storage (S3 protocol). Leave S3_BUCKET empty to store uploads on local disk.
S3_BUCKET=
S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
S3_REGION=ap-northeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Google login for the admin and the customer portal (Google Cloud Console → OAuth client, type "Web application").
# Authorized redirect URIs: <NEXT_PUBLIC_SERVER_URL>/api/users/oauth/google/callback
#                           <NEXT_PUBLIC_SERVER_URL>/api/clients/oauth/google/callback
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these emails can use the admin (comma-separated). Defaults to xiechengfang1@gmail.com.
ADMIN_EMAILS=

# ECPay (綠界) card payments in the customer portal. Leave empty to show bank transfer only.
# Sandbox: ECPAY_ENV=stage, MerchantID 3002607, HashKey pwFHCqoQZGmho4w6, HashIV EkRm7iFT261dpevs
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_ENV=stage

# LINE Official Account (Messaging API channel). Webhook: <NEXT_PUBLIC_SERVER_URL>/line/webhook
# After deploying, run `npm run line:setup` to publish the rich menu and set the webhook URL.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
