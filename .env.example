# Postgres connection string (local, or Supabase "Session pooler" URI in production)
DATABASE_URL=postgres://USER@127.0.0.1:5432/bigzhaung
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=
# Public site URL, no trailing slash (used for SEO links and the sitemap)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Supabase Storage (S3 protocol). Leave S3_BUCKET empty to store uploads on local disk.
S3_BUCKET=
S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
S3_REGION=ap-northeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
